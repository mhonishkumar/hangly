<Window x:Class="Hangly.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="540" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Title="Hangly">
  <Grid Background="Transparent">
    <Canvas x:Name="Scene" Background="Transparent"
            MouseLeftButtonDown="SceneMouseLeftButtonDown"
            MouseMove="SceneMouseMove"
            MouseLeftButtonUp="SceneMouseLeftButtonUp" />
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
            Background="#EFFFF9F0" CornerRadius="12" Padding="8,4">
      <ComboBox x:Name="CharmPicker" Width="112" BorderThickness="0"
                Background="Transparent" Foreground="{DynamicResource Ink}"
                SelectionChanged="CharmPickerSelectionChanged" />
    </Border>
  </Grid>
</Window>